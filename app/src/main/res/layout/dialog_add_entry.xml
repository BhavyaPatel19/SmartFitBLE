<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/smartfit_background"
    android:paddingTop="20dp">


    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/smartfit_card"
        android:elevation="6dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/add_entry_title"
        app:titleTextColor="@color/smartfit_text_primary"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_scrollFlags="scroll|enterAlways" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp"
        android:layout_marginTop="56dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- INPUT CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:cardUseCompatPadding="true"
                app:cardBackgroundColor="@color/smartfit_card"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- PATIENT NAME -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/patient_name"
                        android:textColor="@color/smartfit_text_secondary"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/etPatientName"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_input_box"
                        android:padding="12dp"
                        android:inputType="textPersonName"
                        android:textColor="@color/smartfit_text_primary"
                        android:textColorHint="@color/smartfit_text_secondary"
                        android:hint="@string/enter_patient_name"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="16dp"/>

                    <!-- PATIENT AGE -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/patient_age"
                        android:textColor="@color/smartfit_text_secondary"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/etPatientAge"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_input_box"
                        android:padding="12dp"
                        android:inputType="number"
                        android:textColor="@color/smartfit_text_primary"
                        android:textColorHint="@color/smartfit_text_secondary"
                        android:hint="@string/enter_patient_age"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="16dp"/>

                    <!-- HEART RATE -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/heart_rate_hint"
                        android:textColor="@color/smartfit_text_secondary"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/etHeartRate"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_input_box"
                        android:padding="12dp"
                        android:inputType="number"
                        android:textColor="@color/smartfit_text_primary"
                        android:textColorHint="@color/smartfit_text_secondary"
                        android:hint="@string/enter_heart_rate"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="16dp"/>

                    <!-- SpO2 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/spo2_hint"
                        android:textColor="@color/smartfit_text_secondary"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/etSpo2"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_input_box"
                        android:padding="12dp"
                        android:inputType="number"
                        android:textColor="@color/smartfit_text_primary"
                        android:textColorHint="@color/smartfit_text_secondary"
                        android:hint="@string/enter_spo2"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="16dp"/>

                    <!-- TEMPERATURE -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/temperature_hint"
                        android:textColor="@color/smartfit_text_secondary"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/etTemperature"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_input_box"
                        android:padding="12dp"
                        android:inputType="numberDecimal"
                        android:textColor="@color/smartfit_text_primary"
                        android:textColorHint="@color/smartfit_text_secondary"
                        android:hint="@string/enter_temperature"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- DATE TIME CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="22dp"
                app:cardUseCompatPadding="true"
                app:cardBackgroundColor="@color/smartfit_card">

                <LinearLayout
                    android:padding="20dp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/select_date_time"
                        android:textColor="@color/smartfit_text_secondary"
                        android:textSize="14sp"/>


                    <Button
                        android:id="@+id/btnSelectDateTime"
                        style="@style/SmartFit.PrimaryButton"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="@string/select_date_time"/>

                    <TextView
                        android:id="@+id/tvSelectedDateTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/smartfit_primary"
                        android:textSize="13sp"
                        android:layout_marginTop="12dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BUTTON ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btnCancel"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:text="@string/cancel"
                    android:textColor="@color/smartfit_text_secondary"/>

                <View
                    android:layout_width="12dp"
                    android:layout_height="match_parent"/>

                <Button
                    android:id="@+id/btnSave"
                    style="@style/SmartFit.PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="@string/save"/>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
